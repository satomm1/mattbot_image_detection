<!-- detect.launch -->
<launch>

  <arg name="tall" default="false"/>

  <arg name="weights_file" default="$(find mattbot_image_detection)/weights/osod_updated.pt"/>
  <arg name="labels_file" default="$(find mattbot_image_detection)/scripts/updated_labels.txt"/>

  <arg name="clip_model" default="$(find mattbot_image_detection)/scripts/checkpoints/mobileclip_s0.pt"/>
  <arg name="root_dir" default="$(find mattbot_image_detection)/src/mobileclip"/>

  <arg name="save_dir" default="$(find mattbot_image_detection)/images/"/>
  <arg name="use_llm_for_images" default="false"/>

  <!-- Display options for /camera/color/image_with_boxes -->
  <arg name="display_min_conf" default="0.5"/>
  <arg name="display_depth" default="true"/>
  <arg name="display_overlapped" default="false"/>

  <!-- Which boxes are kept. Class-aware NMS at IoU 0.5 (the original: nms_agnostic:=true nms_iou:=0.1, which
       merged people standing side by side); people at confidence 0.4 (original 0.6; other known classes 0.6,
       unknown 0.25); unknown_dedupe drops "unknown" boxes duplicating a known-class box or lying inside a person. -->
  <arg name="nms_agnostic" default="false"/>
  <arg name="nms_iou" default="0.5"/>
  <arg name="person_conf" default="0.4"/>
  <arg name="unknown_dedupe" default="true"/>

  <!-- Frame input. image_queue_size 1 + a large buffer: each callback gets the NEWEST frame (rospy's defaults
       queue every frame, so detections ran about half a second late). sync_slop: max colour/depth stamp gap of
       a pair, one frame at 30 fps (the detector warns if colour and depth arrive but never pair: raise it). -->
  <arg name="image_queue_size" default="1"/>
  <arg name="sync_slop" default="0.033"/>
  <!-- Turning gate: skip frames while the robot turns fast (colour/depth misalign). turning_source odom = the
       measured yaw rate at the image time; cmd = the original gate on /cmd_vel (use turning_threshold 0.10). -->
  <arg name="turning_source" default="odom"/>
  <arg name="turning_threshold" default="0.8"/>
  <arg name="turning_cooldown" default="0.15"/>

  <!-- How detections are placed (object_ranging). Defaults: robust depth, LiDAR for people.
       range_method: robust (nearest substantial surface in a central/torso window, corrected centre) | legacy (the original estimate)
       person_range_source: lidar (people ranged by the /scan cluster in the box's bearing span, camera fallback) | camera
       publish_range_debug: every method's estimate side by side on /detected_objects_range_debug (JSON) -->
  <!-- max_camera_depth: camera-ranged detections beyond this forward depth (m) are dropped; 8 = the learned planner's
       trained camera range and the Astra's rated maximum (the original limit was 5) -->
  <arg name="max_camera_depth" default="8.0"/>
  <arg name="range_method" default="robust"/>
  <arg name="person_range_source" default="lidar"/>
  <arg name="publish_range_debug" default="false"/>

  <!-- Experimental: decide whether checked ledger objects are still there (bringup observe:=true) -->
  <arg name="observe_evaluate" default="false"/>
  <arg name="observe_use_depth" default="true"/>
  <arg name="observe_min_absent_frames" default="8"/>

  <!-- Launch the object detection script -->
  <node name="image_detector_node" pkg="mattbot_image_detection" type="detect_with_dist_osod.py" output="screen">
    <param name="tall" value="$(arg tall)" />
    <param name="weights_file" value="$(arg weights_file)" />
    <param name="labels_file" value="$(arg labels_file)" />
    <param name="clip_model" value="$(arg clip_model)" />
    <param name="root_dir" value="$(arg root_dir)" />
    <param name="display_min_conf" value="$(arg display_min_conf)" />
    <param name="display_depth" value="$(arg display_depth)" />
    <param name="display_overlapped" value="$(arg display_overlapped)" />
    <param name="nms_agnostic" value="$(arg nms_agnostic)" />
    <param name="nms_iou" value="$(arg nms_iou)" />
    <param name="person_conf" value="$(arg person_conf)" />
    <param name="unknown_dedupe" value="$(arg unknown_dedupe)" />
    <param name="image_queue_size" value="$(arg image_queue_size)" />
    <param name="sync_slop" value="$(arg sync_slop)" />
    <param name="turning_source" value="$(arg turning_source)" />
    <param name="turning_threshold" value="$(arg turning_threshold)" />
    <param name="turning_cooldown" value="$(arg turning_cooldown)" />
    <param name="max_camera_depth" value="$(arg max_camera_depth)" />
    <param name="range_method" value="$(arg range_method)" />
    <param name="person_range_source" value="$(arg person_range_source)" />
    <param name="publish_range_debug" value="$(arg publish_range_debug)" />
  </node>

  <node if="$(arg observe_evaluate)" name="observation_evaluator" pkg="mattbot_image_detection" type="observation_evaluator.py" output="screen">
    <param name="tall" value="$(arg tall)" />
    <param name="use_depth" value="$(arg observe_use_depth)" />
    <param name="min_absent_frames" value="$(arg observe_min_absent_frames)" />
  </node>

  <!-- Launch the gemini bridge -->
  <node name="gemini_bridge" pkg="mattbot_image_detection" type="gemini_bridge.py" output="screen">
    <param name="use_llm_for_images" value="$(arg use_llm_for_images)" />
  </node>

  <!-- Launch the image saver -->
  <!-- <node name="image_saver" pkg="mattbot_image_detection" type="image_saver.py" output="screen">
    <param name="save_dir" value="$(arg save_dir)" />
  </node> -->

  <!-- <node name="image_sender" pkg="mattbot_image_detection" type="dds_image_sender.py" output="screen">
  </node>  -->

</launch>