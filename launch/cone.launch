<!-- navigator_launch_file.launch -->
<launch>

  <arg name="weights_file" default="$(find mattbot_image_detection)/weights/cone.pt"/>

  <!-- Cone detection -->
  <node name="image_detector_node" pkg="mattbot_image_detection" type="detect_cone.py" output="log">
    <param name="weights_file" value="$(arg weights_file)" />
  </node>

</launch>
